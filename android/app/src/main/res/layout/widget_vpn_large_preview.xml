<?xml version="1.0" encoding="utf-8"?>
<!-- Как живой 4×2: лого, круглая кнопка, 4 сервера, стрелки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_weight="38"
        android:clipChildren="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_large_logo"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxHeight="@dimen/widget_large_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_connect_btn" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_power"
                    android:tint="#C0000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/sf_pro_bold"
                    android:includeFontPadding="false"
                    android:text="@string/clev_start"
                    android:textColor="#C0000000"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="62"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_flag_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_preview_flag_gb" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_server_1"
                android:textColor="#FFC400"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_flag_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_preview_flag_de" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_server_2"
                android:textColor="#F2F2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_flag_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_preview_flag_gb" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_server_3"
                android:textColor="#F2F2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_flag_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_preview_flag_nl" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_server_4"
                android:textColor="#F2F2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_arrow_bg"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_widget_chevron_left" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_arrow_bg"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_widget_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
