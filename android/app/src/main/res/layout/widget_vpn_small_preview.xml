<?xml version="1.0" encoding="utf-8"?>
<!-- Как живой 3×1: круглая кнопка слева (не овал), флаг и имя в одну строку. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_preview_connect_btn" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_power"
                android:tint="#C0000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/sf_pro_bold"
                android:includeFontPadding="false"
                android:text="@string/clev_start"
                android:textColor="#C0000000"
                android:textSize="8sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_flag_bg"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_preview_flag_nl" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_server_small"
            android:textColor="#F2F2F5"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
