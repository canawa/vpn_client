<?xml version="1.0" encoding="utf-8"?>
<!-- Простая жёлтая кнопка «Старт» для превью в меню виджетов. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2A2A31" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#FFC400" />
        </shape>
    </item>
</layer-list>
